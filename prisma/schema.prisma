generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  logs             Log[]
  insights         Insight[]
  behavioralEvents BehavioralEvent[]
  decisionLogs     DecisionLog[]
  decisions        Decision[]
}

model Decision {
  id          Int      @id @default(autoincrement())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  tags        String?
  riskScore   Int
  riskLevel   String
  explanation String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model BehavioralEvent {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskType     String?
  plannedTime  DateTime?
  executedTime DateTime?
  energyLevel  Int?
  moodLevel    Int?
  difficulty   Int?
  outcome      String?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
}

model Log {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  behaviorType  BehaviorType
  value         Int
  expectedValue Int?
  outcome       String?      @default("success")
  timestamp     DateTime
  timezone      String?
  note          String?
  createdAt     DateTime     @default(now())
  tags          LogTag[]

  @@index([userId, createdAt])
}

enum BehaviorType {
  ENERGY
  MOOD
}

enum TagCategory {
  Location
  State
  Activity
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  category TagCategory?
  logs     LogTag[]
}

model LogTag {
  log    Log    @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  String

  @@id([logId, tagId])
}

model DecisionLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           String
  context          Json
  outcome          String
  productivityDrop Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model Insight {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           InsightType
  message        String
  recommendation String?
  priority       String
  confidence     Float?
  insights       Json
  analysis       Json
  generatedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())

  @@index([userId, generatedAt])
}

enum InsightType {
  AVERAGE
  TREND
  TIME_OF_DAY
  SUDDEN_DROP
}
