// Prisma schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model BehavioralEvent {
  id          String   @id @default(uuid())
  userId      String
  taskType    String?
  plannedTime DateTime?
  executedTime DateTime?
  energyLevel Int?
  moodLevel   Int?
  difficulty  Int?
  outcome     String?
  createdAt   DateTime @default(now())
}

enum BehaviorType {
  ENERGY
  MOOD
}

enum TagCategory {
  Location
  State
  Activity
}

model Log {
  id            String       @id @default(uuid())
  userId        String
  behaviorType  BehaviorType
  value         Int
  expectedValue Int?
  timestamp     DateTime
  timezone      String?
  note          String?
  createdAt     DateTime     @default(now())
  tags          LogTag[]
}

model Tag {
  id       String   @id @default(uuid())
  name     String   @unique
  category TagCategory?
  logs     LogTag[]
}

model LogTag {
  log   Log   @relation(fields: [logId], references: [id])
  logId String
  tag   Tag   @relation(fields: [tagId], references: [id])
  tagId String

  @@id([logId, tagId])
}

model Insight {
  id           String    @id @default(uuid())
  behaviorType BehaviorType
  insights     Json
  analysis     Json
  generatedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())
}
